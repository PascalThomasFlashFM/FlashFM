{
  "name": "flashfm-voyance",
  "version": "1.0.0",
  "description": "Synchronisation des inscriptions BOCIR vers Google Sheet + validation manuelle des mails de confirmation pour l'emission La Voyance en direct (Flash FM)",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/web/public && cp -r src/web/public/. dist/web/public/",
    "start": "node dist/cli.js",
    "sync": "node dist/cli.js sync",
    "serve": "node dist/cli.js serve",
    "dev:sync": "tsx src/cli.ts sync",
    "dev:serve": "tsx src/cli.ts serve"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "googleapis": "^144.0.0",
    "nodemailer": "^6.9.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.16",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
