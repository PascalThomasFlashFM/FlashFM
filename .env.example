# ---- BOCIR (formulaire d'inscription) ----
BOCIR_API_KEY=
BOCIR_BEARER_TOKEN=
# Identifiant du formulaire "La Voyance en direct" dans BOCIR.
# Change si le formulaire est un jour recree : ne jamais le coder ailleurs qu'ici.
BOCIR_FORM_ID=

# ---- Google Sheets ----
GOOGLE_SHEET_ID=
# Nom exact de l'onglet a utiliser (change chaque saison)
GOOGLE_SHEET_TAB=2026-2027
# Chemin vers le fichier JSON de la cle du compte de service Google.
# Ne jamais committer ce fichier (voir .gitignore).
GOOGLE_SERVICE_ACCOUNT_JSON=./credentials/google-service-account.json

# ---- SMTP (OVH) ----
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=pascal@flashfm.fr
SMTP_PASSWORD=
MAIL_FROM=pascal@flashfm.fr

# ---- Application ----
# Chemin de la base SQLite (etat de synchro + inscriptions)
DB_PATH=./data/voyance.sqlite
# Fichier de log des executions
LOG_PATH=./data/app.log
# Port du serveur web de validation
WEB_PORT=3000
